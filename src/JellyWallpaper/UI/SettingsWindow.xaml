<Window x:Class="JellyWallpaper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JellyWallpaper 设置" Width="520" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" ShowInTaskbar="False"
        Background="#F3F4F6" FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F6F5C"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="RowLbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题 -->
            <RowDefinition Height="Auto"/>  <!-- 壁纸 -->
            <RowDefinition Height="Auto"/>  <!-- 果冻形变 -->
            <RowDefinition Height="Auto"/>  <!-- 快捷键 -->
            <RowDefinition Height="Auto"/>  <!-- 其它 -->
            <RowDefinition Height="*"/>     <!-- 日志 -->
            <RowDefinition Height="Auto"/>  <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题 + 版本 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="JellyWallpaper 果冻壁纸" FontSize="18" FontWeight="Bold" Foreground="#14532D"/>
            <TextBlock x:Name="VersionText" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 壁纸设置 -->
        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource SecTitle}" Text="壁纸"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="图片文件夹"/>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="浏览…" Margin="6,0,0,0" Padding="10,3"/>
                </Grid>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="显示模式"/>
                <ComboBox x:Name="ModeBox" Grid.Column="1" VerticalContentAlignment="Center"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="背景填充色"/>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FillColorBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="PickColorBtn" Grid.Column="1" Content="取色…" Margin="6,0,0,0" Padding="10,3"/>
                </Grid>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="轮换间隔(秒)"/>
                <TextBox x:Name="IntervalBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="3" Style="{StaticResource RowLbl}" Text="轮换顺序"/>
                <ComboBox x:Name="OrderBox" Grid.Column="4" VerticalContentAlignment="Center"/>
            </Grid>
            <Button x:Name="SwitchNowBtn" Content="立即随机切换壁纸" Margin="0,8,0,0" Padding="10,4" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 果冻形变参数 -->
        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource SecTitle}" Text="果冻形变"/>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="形变强度"/>
                <Slider x:Name="StrengthSlider" Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                <TextBlock x:Name="StrengthVal" Grid.Column="2" Style="{StaticResource RowLbl}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="回弹速度"/>
                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="20" Maximum="300" TickFrequency="5"/>
                <TextBlock x:Name="SpeedVal" Grid.Column="2" Style="{StaticResource RowLbl}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="按压衰减系数"/>
                <Slider x:Name="DampingSlider" Grid.Column="1" Minimum="2" Maximum="40" TickFrequency="1"/>
                <TextBlock x:Name="DampingVal" Grid.Column="2" Style="{StaticResource RowLbl}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="形变渲染分辨率"/>
                <ComboBox x:Name="ResBox" Grid.Column="1" VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- 全局快捷键 -->
        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource SecTitle}" Text="全局快捷键（手动随机换壁纸）"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="组合键"/>
                <CheckBox x:Name="ModCtrl"  Grid.Column="1" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ModAlt"   Grid.Column="2" Content="Alt" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ModShift" Grid.Column="3" Content="Shift" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ModWin"   Grid.Column="4" Content="Win" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource RowLbl}" Text="触发按键"/>
                <TextBox x:Name="HotkeyKeyBox" Grid.Column="1" IsReadOnly="True"
                         ToolTip="点击后按下新按键，松手即记录"
                         Foreground="#374151" Background="White"/>
            </Grid>
            <TextBlock x:Name="HotkeyStatus" Foreground="#B45309" Margin="110,4,0,0"/>
        </StackPanel>

        <!-- 其它 -->
        <StackPanel Grid.Row="4">
            <TextBlock Style="{StaticResource SecTitle}" Text="其它"/>
            <CheckBox x:Name="AutoStartBox" Content="开机自动启动（进入系统托盘）" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 日志 -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource SecTitle}" Text="运行日志" Margin="0,0,0,4"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Height="140" FontFamily="Consolas" FontSize="11" Background="White"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RestoreBtn" Content="恢复默认" Padding="14,5" Margin="0,0,8,0"/>
            <Button x:Name="CloseBtn" Content="关闭（后台继续运行）" Padding="14,5" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
